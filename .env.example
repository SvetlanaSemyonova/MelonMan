# Supabase → Project Settings → API (или Connect → App frameworks)
# Во фронтенд попадает только anon / publishable key, не service_role.

# Пример для проекта tpavxbgwhifuiynhrzgk — подставьте свой ref при необходимости.
VITE_SUPABASE_URL=https://tpavxbgwhifuiynhrzgk.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Опционально: применить миграции через CLI (пароль — Database password в Supabase Dashboard).
# Не коммитьте реальный URL с паролем.
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
